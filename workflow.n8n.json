          "values": [
            {
              "name": "chapterContent_current",
              "label": "Chapter Content (Chapter {{ $getInput(1).item.json.value }})",
              "type": "string",
              "default": "",
              "placeholder": "Enter the content for this chapter",
              "typeOptions": {
                "rows": 5
              }
            }
          ]
        },
        "options": {}
      },
      "name": "Chapter Content Input",
      "type": "n8n-nodes-base.userInput",
      "typeVersion": 1,
      "position": [
        850,
        420 // Adjusted position for clarity
      ],
      "id": "d4e5f6a7-b8c9-0123-4567-890abcdef123"
    },
    {
      "parameters": {
        "functionCode": "// Retrieve book details.\nconst bookDetailsNode = $('Book Details Input');\nconst bookTitle = bookDetailsNode.item.json.bookTitle;\nconst bookAuthor = bookDetailsNode.item.json.bookAuthor;\n\nlet markdownContent = `# ${bookTitle}\\n\\n`;\nmarkdownContent += `**By: ${bookAuthor}**\\n\\n`;\nmarkdownContent += `---\\n\\n`;\n\nfor (const item of items) {\n  const chapterTitle = item.json.chapterTitle_current;\n  const chapterContent = item.json.chapterContent_current;\n\n  if (chapterTitle) {\n    markdownContent += `## ${chapterTitle}\\n\\n`;\n  }\n  if (chapterContent) {\n    markdownContent += `${chapterContent}\\n\\n`;\n  }\n  markdownContent += `---\\n\\n`;\n}\n\nreturn [{ json: { finalMarkdown: markdownContent, bookFileName: `${bookTitle}.md` } }];"
      },
      "name": "Assemble Markdown",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1150,
        300
      ],
      "id": "e5f6a7b8-c9d0-1234-5678-90abcdef1234"
    },
    {
      "parameters": {
        "operation": "upload",
        "binaryData": true,
        "fileContent": "{{ $json.finalMarkdown }}",
        "fileName": "{{ $json.bookFileName }}",
        "parent": "", // Placeholder for Parent Folder ID
        "mimeType": "text/markdown",
        "options": {}
      },
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-google.drive",
      "typeVersion": 1,
